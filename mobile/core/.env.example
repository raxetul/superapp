# SuperApp mobile core — runtime configuration (TR-08-007).
# Expo inlines every EXPO_PUBLIC_* variable into the JS bundle at build time.
# Copy to `.env` and fill in. Missing a REQUIRED var fails loudly at startup.

# --- REQUIRED ---
# Backend core API base URL (no trailing slash needed; it is stripped).
EXPO_PUBLIC_API_BASE_URL=https://api.superapp.example.com
# Rauthy OIDC issuer (discovery is derived from this).
EXPO_PUBLIC_OIDC_ISSUER=https://idp.superapp.example.com
# Public OAuth client id registered for the mobile app.
EXPO_PUBLIC_OIDC_CLIENT_ID=superapp-mobile
# Custom URL scheme for the deep-link redirect (must match app.json `scheme`).
EXPO_PUBLIC_OIDC_SCHEME=superapp

# --- OPTIONAL ---
# Redirect path appended to the scheme (default: oauthredirect).
# EXPO_PUBLIC_OIDC_REDIRECT_PATH=oauthredirect
# Space-separated OAuth scopes (default: openid profile email offline_access).
# EXPO_PUBLIC_OIDC_SCOPES=openid profile email offline_access
