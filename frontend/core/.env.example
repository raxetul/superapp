# SuperApp frontend/core configuration (TR-07-007).
# All client config is exposed via VITE_* variables. Copy to `.env.local`.
# A missing REQUIRED variable fails fast at startup with a clear error.

# --- Required ---
# Base URL of the SuperApp backend API (no trailing slash).
VITE_API_BASE_URL=http://localhost:5150

# Rauthy OIDC issuer / authority URL.
VITE_OIDC_ISSUER=http://localhost:8080/auth/v1

# OIDC public client id registered in Rauthy for this SPA.
VITE_OIDC_CLIENT_ID=superapp-web

# Redirect URI registered in Rauthy (must match this app's callback route).
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# --- Optional (defaults shown) ---
# Space-separated OIDC scopes.
VITE_OIDC_SCOPE=openid profile email
# Post-logout redirect URI.
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
