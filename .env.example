# SuperApp — environment template. Copy to `.env` and adjust. `.env` is gitignored.
# Backend config uses the SUPERAPP_BACKEND_ prefix (layered over loco config/*.yaml).

# --- Infrastructure credentials (consumed by docker-compose) ---
POSTGRES_USER=superapp
POSTGRES_PASSWORD=superapp
POSTGRES_DB=superapp
GRAFANA_ADMIN_PASSWORD=admin

# --- Backend connection strings (service-name hosts on the `superapp` network) ---
SUPERAPP_BACKEND_DATABASE_URL=postgres://superapp:superapp@superapp-postgres:5432/superapp
SUPERAPP_BACKEND_REDIS_URL=redis://superapp-redis:6379
SUPERAPP_BACKEND_KAFKA_BROKERS=superapp-kafka:9092

# --- Host/port coordinates (used by scripts/check-connectivity.sh from the host) ---
SUPERAPP_BACKEND_DB_HOST=localhost
SUPERAPP_BACKEND_DB_PORT=5432
SUPERAPP_BACKEND_REDIS_HOST=localhost
SUPERAPP_BACKEND_REDIS_PORT=6379
SUPERAPP_BACKEND_KAFKA_HOST=localhost
SUPERAPP_BACKEND_KAFKA_PORT=9092
SUPERAPP_BACKEND_PROM_HOST=localhost
SUPERAPP_BACKEND_PROM_PORT=9090
SUPERAPP_BACKEND_GRAFANA_HOST=localhost
SUPERAPP_BACKEND_GRAFANA_PORT=3001

# --- App deployment (docker-compose.app.yml, TR-10-005/007) ---
# Image tag CI publishes/pulls (TR-10-006); "dev" for a local build.
SUPERAPP_VERSION=dev
# Which loco config profile the backend container loads (development/production).
SUPERAPP_ENV=production
SUPERAPP_BACKEND_PORT=5150
SUPERAPP_FRONTEND_PORT=8081
# Name of the P2 infra network app containers attach to (project.md/
# REQUIREMENTS.md's "helvetia-compose" network — literally `superapp`,
# created by the root docker-compose.yml; see docs/phases/p10-*.md).
SUPERAPP_INFRA_NETWORK=superapp
# Required (no default) by docker-compose.app.prod.yml only — dev uses
# config/development.yaml's own fixed non-secret value instead.
SUPERAPP_BACKEND_JWT_SECRET=
# Self-hosted private OCI registry modules are resolved/published from
# (TR-09-009/TR-10-006), e.g. registry.superapp.internal. Never a public registry.
SUPERAPP_BACKEND_MODULE_REGISTRY_HOST=

# --- Frontend build-time config (baked into the image at `docker build`, TR-10-004/007) ---
VITE_API_BASE_URL=http://localhost:5150
VITE_OIDC_ISSUER=http://localhost:8080/auth/v1
VITE_OIDC_CLIENT_ID=superapp-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
